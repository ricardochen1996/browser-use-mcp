+def recording_session(monkeypatch):
+    """Hand `serve` one fake Session and return how it was torn down, in order.
+
+    `shutdown` is the teardown that stops the browser a launch-mode sidecar owns; `close` only drops
+    the tab, so which one end-of-input reaches is the whole contract here.
+    """
+    teardown = []
+
+    class Recording:
+        owned_browser = object()  # the Chrome a launch-mode sidecar started, and must not leak
+
+        def close(self, params=None):
+            teardown.append("close")
+            return {"closed": True}
+
+        def shutdown(self, params=None):
+            teardown.append("shutdown")
+            return {"bye": True}
+
+    monkeypatch.setattr(bridge, "Session", Recording)
+    return teardown
+
+
+def test_end_of_input_shuts_down_the_browser_this_sidecar_launched(monkeypatch):
+    """A host that dies without a shutdown request (SIGKILL) leaves its child only end-of-input."""
+    teardown = recording_session(monkeypatch)
+    assert bridge.serve(io.StringIO(""), io.StringIO()) is None
+    assert teardown == ["shutdown"]
+
+
+def test_a_shutdown_request_then_end_of_input_tears_down_twice_without_error(monkeypatch):
+    teardown = recording_session(monkeypatch)
+    outstream = io.StringIO()
+    bridge.serve(io.StringIO(json.dumps({"id": 1, "method": "shutdown"}) + "\n"), outstream)
+    # The explicit request already stopped everything; the second teardown is harmless and has to
+    # stay harmless, because the tail cannot know a shutdown request came before the end of input.
+    assert teardown == ["shutdown", "shutdown"]
+    assert [json.loads(line) for line in outstream.getvalue().splitlines()] == [
+        {"id": 1, "result": {"bye": True}}
+    ]
+
+
+def test_serve_returns_at_end_of_input_after_answerable_requests(monkeypatch):
+    teardown = recording_session(monkeypatch)
+    outstream = io.StringIO()
+    assert bridge.serve(io.StringIO(json.dumps({"id": 7, "method": "hello"}) + "\n"), outstream) is None
+    answers = [json.loads(line) for line in outstream.getvalue().splitlines()]
+    assert [answer.get("id") for answer in answers] == [7]
+    assert answers[0]["result"]["protocol"] == bridge.PROTOCOL
+    assert teardown == ["shutdown"]
+
+
+def test_a_shutdown_that_fails_at_end_of_input_still_closes_the_tab(monkeypatch):
+    """The fallback keeps a broken teardown from ending the sidecar on a traceback."""
+    teardown = []
+
+    class Failing:
+        def close(self, params=None):
+            teardown.append("close")
+            return {"closed": True}
+
+        def shutdown(self, params=None):
+            raise RuntimeError("the daemon could not be stopped")
+
+    monkeypatch.setattr(bridge, "Session", Failing)
+    bridge.serve(io.StringIO(""), io.StringIO())
+    assert teardown == ["close"]
+
+
