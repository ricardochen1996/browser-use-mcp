+def test_diagnostics_enable_console_and_network_on_the_run_own_session(monkeypatch, session):
+    """The event buffer only carries domains a session enabled, and the run drives its own session."""
+    monkeypatch.setattr(bridge, "drain_events", lambda: [])
+    call(session, "diagnostics")
+    assert session.browser.enabled == ["Runtime.enable", "Network.enable"]
+    call(session, "diagnostics")
+    # Once per session: the second call has nothing new to ask the daemon for.
+    assert session.browser.enabled == ["Runtime.enable", "Network.enable"]
+
+
+def test_a_tab_the_engine_followed_is_watched_as_its_own_session(monkeypatch, session):
+    monkeypatch.setattr(bridge, "drain_events", lambda: [])
+    call(session, "diagnostics")
+    session.browser.session = "session-2"  # the engine followed a link into a tab it opened
+    call(session, "diagnostics")
+    assert session.browser.enabled == ["Runtime.enable", "Network.enable"] * 2
+
+
+def test_open_watches_the_session_before_the_first_observation(monkeypatch):
+    """The first page load is exactly the console output a caller asks about first."""
+    observed = []
+
+    class Watching(FakeBrowser):
+        def observe(self, screenshot=True):
+            observed.append(list(self.enabled))
+            return dict(self.state)
+
+    monkeypatch.setenv("BU_CDP_WS", "ws://127.0.0.1:9/devtools/browser/test")
+    opened = bridge.Session(open_browser=lambda url, reuse=False: Watching(url, reuse=reuse),
+                            launch=pytest.fail)
+    call(opened, "open", url="https://example.test/", mode="attach")
+    assert observed == [["Runtime.enable", "Network.enable"]]
+
+
+def test_a_domain_that_cannot_be_enabled_never_breaks_the_call_it_belongs_to(session, monkeypatch):
+    def refuse(method, **params):
+        if method.endswith(".enable"):
+            raise RuntimeError("Runtime.enable is not available")
+        return {}
+
+    session.browser.call = refuse
+    monkeypatch.setattr(bridge, "drain_events", lambda: [])
+    assert call(session, "diagnostics")["console"] == []
+
+
+def test_a_daemon_that_has_vanished_is_a_lost_session_not_a_raw_os_error(monkeypatch, session):
+    def missing(params):
+        raise FileNotFoundError(2, "No such file or directory")
+
+    session.observe = missing
+    monkeypatch.setattr(bridge._ipc, "ping", lambda name, timeout=1.0: False)
+    error = failure(session, "observe")
+    assert error["kind"] == "lost_session"
+    assert "browser_open" in error["message"]
+    assert "FileNotFoundError" not in error["message"]
+
+
+def test_an_os_error_with_the_daemon_still_answering_stays_a_browser_error(monkeypatch, session):
+    def refused(params):
+        raise ConnectionRefusedError(61, "Connection refused")
+
+    session.observe = refused
+    monkeypatch.setattr(bridge._ipc, "ping", lambda name, timeout=1.0: True)
+    error = failure(session, "observe")
+    assert error["kind"] == "browser_error" and "ConnectionRefusedError" in error["message"]
+
+
