+def test_diagnostics_enable_console_and_network_on_the_run_own_session(monkeypatch, session):
+    """The event buffer only carries domains a session enabled, and the run drives its own session."""
+    monkeypatch.setattr(bridge, "drain_events", lambda: [])
+    call(session, "diagnostics")
+    assert session.browser.enabled == ["Runtime.enable", "Network.enable"]
+    call(session, "diagnostics")
+    # Once per session: the second call has nothing new to ask the daemon for.
+    assert session.browser.enabled == ["Runtime.enable", "Network.enable"]
